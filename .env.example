ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/family_expense
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET_KEY=change-this-to-a-random-secret-in-real-deployments
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=receipts
VITE_API_BASE_URL=http://localhost:8000

# Migration safety controls (used by backend/scripts/safe_migrate.py)
ALLOW_DESTRUCTIVE_MIGRATIONS=0
MIGRATION_BACKUP_DIR=../backups/db
